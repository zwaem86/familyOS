# Runtime: secrets separately generate, never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/familyos
# Canonical origin; HTTPS required except for loopback-only local tests.
NEXTAUTH_URL=http://127.0.0.1:3000
AUTH_SECRET=
# At least 32 random characters; remove after successful initial setup.
BOOTSTRAP_SECRET=
# Registry publishing remains a separate, explicitly authorized operation.
# REGISTRY=
# IMAGE_NAMESPACE=
# IMAGE_NAME=familyos
# VERSION=0.2.0
# PLATFORMS=linux/amd64
